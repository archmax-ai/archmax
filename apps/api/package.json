{
  "name": "@archmax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./mcp/semantics-server": "./src/mcp/semantics-server.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:db-rename": "node --import tsx src/scripts/migrate-db-rename.ts",
    "migrate:view-query": "node --import tsx src/scripts/migrate-view-query.ts"
  },
  "dependencies": {
    "@archmax/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "better-auth": "^1.7.3",
    "deepagents": "^1.13.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "js-yaml": "^5.2.2",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
